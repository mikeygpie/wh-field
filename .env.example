# Copy to .env.local and fill in from your Supabase project (Settings > API).
# Leave both blank to run the app local-only (no sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Set to anonymous to skip accounts: each device is signed in silently.
# Anyone with the app URL can then read and write. Leave blank for email + password.
VITE_AUTH_MODE=
